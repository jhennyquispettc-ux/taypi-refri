# Copia este archivo como .env y completa los valores.
# URL base del backend (sin /api al final)
VITE_API_URL=http://localhost:3000
# Client ID de Google (OAuth 2.0, tipo "Aplicación web"); debe ser el mismo que usa el backend
VITE_GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxx.apps.googleusercontent.com
