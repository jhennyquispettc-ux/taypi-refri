# Supabase > Connect > Session pooler (IPv4, puerto 5432). Render no soporta IPv6.
DATABASE_URL=postgresql://postgres.TU-PROYECTO:TU-CONTRASEÑA@aws-0-REGION.pooler.supabase.com:5432/postgres

# Texto largo y aleatorio para firmar los JWT
JWT_SECRET=cambia-esto-por-un-secreto-largo

# Google Cloud Console > APIs y servicios > Credenciales > ID de cliente OAuth (aplicación web)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Clave del ESP32 (la misma que firmware/config.py -> DEVICE_KEY)
DEVICE_KEY=cambia-esta-clave-del-esp32

# URL de la web (Vercel); varias separadas por coma
WEB_ORIGIN=http://localhost:5173

PORT=3000
